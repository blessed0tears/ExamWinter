<Page x:Class="FragrantWorld.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FragrantWorld.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizePage"
      Background="#FFF0F5">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
        <TextBlock Text="Авторизация" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#C71585" Margin="0,0,0,20"/>
        <StackPanel>
            <TextBlock Text="Логин:" FontFamily="Comic Sans MS" Foreground="#FF69B4"/>
            <TextBox x:Name="LoginTextBox" FontFamily="Comic Sans MS" Background="#FFE4E9" BorderBrush="#FFB6C1"/>
        </StackPanel>
        <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Пароль:" FontFamily="Comic Sans MS" Foreground="#FF69B4"/>
            <PasswordBox x:Name="PasswordTextBox" FontFamily="Comic Sans MS" Background="#FFE4E9" BorderBrush="#FFB6C1"/>
        </StackPanel>
        <StackPanel Margin="5,20,5,0">
            <Button x:Name="AuthorizationButton" Content="Войти" Margin="5" FontFamily="Comic Sans MS" Click="AuthorizationButton_Click" Background="#FF69B4" Foreground="White"/>
            <Button x:Name="GuestButton" Content="Войти как гость" Margin="5" FontFamily="Comic Sans MS" Click="GuestButton_Click" Background="#FFB6C1" Foreground="Black"/>
        </StackPanel>
    </StackPanel>
</Page>